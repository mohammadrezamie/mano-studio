# All 25 named Basic Computer instructions, plus seven indirect forms.
# Instruction-level translation showcase, NOT an executable program.
AC <- AC & M[100]
AC <- AC + M[101]
AC <- M[102]
M[103] <- AC
PC <- 104
M[105] <- PC, PC <- 105 + 1
M[106] <- M[106] + 1, IF M[106] = 0 THEN PC <- PC + 1
AC <- AC & M[M[100]]
AC <- AC + M[M[101]]
AC <- M[M[102]]
M[M[103]] <- AC
PC <- M[104]
M[M[105]] <- PC, PC <- M[105] + 1
M[M[106]] <- M[M[106]] + 1, IF M[M[106]] = 0 THEN PC <- PC + 1
AC <- 0
E <- 0
AC <- ~AC
E <- ~E
E:AC <- CIR(E:AC)
E:AC <- CIL(E:AC)
AC <- AC + 1
IF AC[15] = 0 THEN PC <- PC + 1
IF AC[15] = 1 THEN PC <- PC + 1
IF AC = 0 THEN PC <- PC + 1
IF E = 0 THEN PC <- PC + 1
S <- 0
AC[7:0] <- INPR, FGI <- 0
OUTR <- AC[7:0], FGO <- 0
IF FGI = 1 THEN PC <- PC + 1
IF FGO = 1 THEN PC <- PC + 1
IEN <- 1
IEN <- 0
